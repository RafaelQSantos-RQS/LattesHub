# Banco de Dados
DB_USER=postgres
DB_PASSWORD=
DB_NAME=lattes_hub
DB_PORT_EXTERNAL=5437
DB_HOST=db
DB_PORT=5432
EMBEDDING_BATCH_SIZE=100

# Opcional: use para apontar o backend/testes para Supabase ou outro Postgres externo.
# Quando definido, DATABASE_URL tem precedencia sobre DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=
# DB_SSLMODE=require

# Backend
BACKEND_PORT=8000
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Frontend
FRONTEND_PORT=4200
LATTESHUB_API_PROXY_TARGET=http://localhost:8000

# OpenAI
OPENAI_API_KEY=
