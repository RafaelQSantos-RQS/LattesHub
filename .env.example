# ==============================================================================
# Configurações de Banco de Dados (Supabase ou Local)
# ==============================================================================
# Se for usar banco local (Docker), mantenha DB_HOST=db.
# Se for usar Supabase, preencha o host do Connection Pooler (ex: aws-1-sa-east-1.pooler.supabase.com)
DB_HOST=db
DB_PORT=5432
DB_PORT_EXTERNAL=5437
DB_NAME=postgres
DB_USER=postgres.sua_chave_ou_user
DB_PASSWORD=sua_senha_aqui

# Conexão via URL (Tem precedência sobre as variáveis individuais acima)
# Exemplo Supabase: postgresql://postgres.ID_PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Use require para Supabase/Postgres externo que exige SSL.
DB_SSLMODE=disable

# ==============================================================================
# Configurações da Aplicação
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
EMBEDDING_BATCH_SIZE=100
EMBEDDING_PRODUCTION_TYPES=ARTIGO PUBLICADO,TRABALHO EM EVENTOS,LIVRO PUBLICADO,CAPITULO DE LIVRO

# Portas dos serviços
BACKEND_PORT=8000
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Frontend
FRONTEND_PORT=4200
LATTESHUB_API_PROXY_TARGET=http://localhost:8000

# ==============================================================================
# Serviços Externos
# ==============================================================================
OPENAI_API_KEY=sk-xxxx...

# Supabase Client
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-aqui
