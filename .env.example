# ==============================================================================
# Banco de Dados — Supabase (padrão)
# ==============================================================================
# Preencha a connection string do Session Pooler do seu projeto Supabase.
# ATENÇÃO: copie a URL exata do painel Supabase → Settings → Database → Connection string.
# O prefixo aws-X (ex: aws-1, aws-2) é específico do seu projeto e não pode ser assumido.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-X-sa-east-1.pooler.supabase.com:5432/postgres
DB_SSLMODE=require

# ==============================================================================
# Banco de Dados — Local (apenas se usar o profile local-db)
# ==============================================================================
# Usado pelo Apache Hop (ETL) e pelo serviço db quando rodado com:
#   docker compose --profile local-db up db
# Se DATABASE_URL estiver definida acima, o backend a usa com prioridade.
# Para usar Supabase com o ETL (Apache Hop), ajuste DB_HOST/DB_USER/DB_PASSWORD
# para apontar ao mesmo pooler do DATABASE_URL (ex: DB_USER=postgres.SEU_PROJECT_REF).
DB_HOST=db
DB_PORT=5432
DB_PORT_EXTERNAL=5437
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ==============================================================================
# Configurações da Aplicação
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
EMBEDDING_BATCH_SIZE=100
EMBEDDING_PRODUCTION_TYPES=ARTIGO PUBLICADO,TRABALHO EM EVENTOS,LIVRO PUBLICADO,CAPITULO DE LIVRO

# Portas dos serviços
BACKEND_PORT=8000
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Frontend
FRONTEND_PORT=4200
LATTESHUB_API_PROXY_TARGET=http://localhost:8000

# ==============================================================================
# Serviços Externos
# ==============================================================================
OPENAI_API_KEY=sk-xxxx...

# Supabase Client (para uso futuro com Auth, Storage ou Realtime)
# Chave anon/publishable — segura para expor no frontend.
# Só dá acesso ao que as políticas de RLS permitirem.
SUPABASE_URL=https://xhlboccdgyjlghwelufs.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Cc7zOM3EviozjenAvdNiyw_6VYGgrei
