# Copy this file to .env.production on the deployment host.
# Do not commit .env.production with real secrets.

# ==============================================================================
# Banco de Dados — Supabase (padrão para produção)
# ==============================================================================
# ATENÇÃO: copie a URL exata do painel Supabase → Settings → Database → Connection string.
# O prefixo aws-X (ex: aws-1, aws-2) é específico do seu projeto e não pode ser assumido.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-X-sa-east-1.pooler.supabase.com:5432/postgres
DB_SSLMODE=require

# Variáveis individuais usadas pelo Apache Hop (ETL).
# Devem apontar para o mesmo host do Supabase acima (mesma URL, sem o scheme).
DB_HOST=aws-X-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA

# ==============================================================================
# Backend
# ==============================================================================
APP_ENV=production
ENVIRONMENT=production
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://latteshub.example.com

# ==============================================================================
# Frontend
# ==============================================================================
FRONTEND_PORT=8080

# ==============================================================================
# Embeddings
# ==============================================================================
EMBEDDING_BATCH_SIZE=100
EMBEDDING_PRODUCTION_TYPES=ARTIGO PUBLICADO,TRABALHO EM EVENTOS,LIVRO PUBLICADO,CAPITULO DE LIVRO

# ==============================================================================
# Serviços Externos
# ==============================================================================
OPENAI_API_KEY=CHANGE_ME
