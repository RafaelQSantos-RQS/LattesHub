# Copy this file to .env.production on the deployment host.
# Do not commit .env.production with real secrets.

# Database
DB_USER=latteshub
DB_PASSWORD=CHANGE_ME
DB_NAME=lattes_hub
DB_HOST=db
DB_PORT=5432

# Optional external Postgres connection. Leave empty when using the db service.
# DATABASE_URL=
# DB_SSLMODE=require

# Backend
APP_ENV=production
BACKEND_CORS_ORIGINS=https://latteshub.example.com

# Frontend
FRONTEND_PORT=8080

# Embeddings
EMBEDDING_BATCH_SIZE=100
OPENAI_API_KEY=CHANGE_ME
