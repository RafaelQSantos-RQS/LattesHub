<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pipeline_qualis</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description />
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Ler CSV Qualis</from>
      <to>Limpar ISSN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Limpar ISSN</from>
      <to>Replace in string</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Replace in string</from>
      <to>Ordenar ISSN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordenar ISSN</from>
      <to>Remover Duplicados</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remover Duplicados</from>
      <to>Table Output - Qualis</to>
      <enabled>Y</enabled>
    </hop>
  </order>

  <transform>
    <name>Ordenar ISSN</name>
    <type>SortRows</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory />
    <compress>N</compress>
    <compress_variable />
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>ISSN</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>544</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Remover Duplicados</name>
    <type>Unique</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <count_rows>N</count_rows>
    <count_field />
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description />
    <fields>
      <field>
        <name>ISSN</name>
        <case_insensitive>N</case_insensitive>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>544</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Table Output - Qualis</name>
    <type>TableOutput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <commit>10000</commit>
    <connection>DB_LATTES_HUB</connection>
    <fields>
      <field>
        <column_name>issn</column_name>
        <stream_name>ISSN</stream_name>
      </field>
      <field>
        <column_name>titulo</column_name>
        <stream_name>Título</stream_name>
      </field>
      <field>
        <column_name>area_avaliacao</column_name>
        <stream_name>Área de Avaliação</stream_name>
      </field>
      <field>
        <column_name>estrato</column_name>
        <stream_name>Estrato</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>public</schema>
    <specify_fields>Y</specify_fields>
    <table>qualis_periodicos</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI>
      <xloc>736</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Ler CSV Qualis</name>
    <type>CSVInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <filename>${PROJECT_HOME}/data/qualis/qualis_2020_2024.csv</filename>
    <filename_field />
    <rownum_field />
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition />
    <ignoreFields>N</ignoreFields>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>ISSN</name>
        <type>String</type>
        <format />
        <currency />
        <decimal />
        <group />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>Título</name>
        <type>String</type>
        <format />
        <currency />
        <decimal />
        <group />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>Área de Avaliação</name>
        <type>String</type>
        <format />
        <currency />
        <decimal />
        <group />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>Estrato</name>
        <type>String</type>
        <format />
        <currency />
        <decimal />
        <group />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>288</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Limpar ISSN</name>
    <type>StringOperations</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <in_stream_name>ISSN</in_stream_name>
        <out_stream_name />
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char />
        <pad_len />
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>320</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Replace in string</name>
    <type>ReplaceString</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <case_sensitive>no</case_sensitive>
        <in_stream_name>ISSN</in_stream_name>
        <is_unicode>no</is_unicode>
        <out_stream_name />
        <replace_by_string />
        <replace_field_by_string />
        <replace_string>-</replace_string>
        <set_empty_string>N</set_empty_string>
        <use_regex>no</use_regex>
        <whole_word>no</whole_word>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>448</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>
</pipeline>